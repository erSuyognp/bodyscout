# Copy to .env and fill in. .env is gitignored; never put keys in code.
# Leave a key empty to switch that LLM hypothesizer off (the swarm runs fine with none).

# Claude hypothesizer (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Gemini hypothesizer (https://aistudio.google.com/apikey); GOOGLE_API_KEY also works
GEMINI_API_KEY=

# Optional model overrides
BODYSCOUT_MODEL=claude-sonnet-5-5
BODYSCOUT_GEMINI_MODEL=gemini-2.5-flash
